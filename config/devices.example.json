{
  "devices": [
    {
      "id": "pinoc",
      "hostname": "pinoc",
      "friendly_name": "PiNOC Console",
      "address": "pinoc.local",
      "collection_method": "local",
      "roles": [
        "pinoc",
        "desk_display"
      ],
      "tags": [
        "display",
        "production"
      ],
      "monitored_services": [
        "pi-noc.service"
      ],
      "manageable_services": [
        "desk-display.service"
      ],
      "expected_listeners": [
        "tcp:22",
        "tcp:8088"
      ],
      "config_drift": {
        "expected_units": [
          "ssh.service"
        ],
        "expected_files": {
          "/etc/ssh/sshd_config": "44c91857f34b1ec68e246ebcbad66c4b9380b41c3490c719bdfd6696ba7b40b5"
        },
        "expected_sshd_options": {
          "PermitRootLogin": "no",
          "PasswordAuthentication": "no"
        }
      },
      "allowed_actions": [
        "config_drift.reenable_unit",
        "config_drift.restore_file"
      ],
      "integrations": {
        "probe": {
          "enabled": true,
          "checks": [
            {
              "name": "console-health",
              "kind": "http_get",
              "url": "http://127.0.0.1:8088/health",
              "timeout_seconds": 5,
              "interval_seconds": 60,
              "pattern": "\\\"status\\\":\\\"ok\\\""
            },
            {
              "name": "console-cert",
              "kind": "tls_cert",
              "host": "pinoc.local",
              "port": 443,
              "timeout_seconds": 5,
              "interval_seconds": 3600
            }
          ]
        }
      }
    },
    {
      "id": "piawaren",
      "hostname": "piawaren",
      "friendly_name": "ADS-B North",
      "address": "piawaren.local",
      "collection_method": "ssh",
      "ssh_user": "pi",
      "ssh_port": 22,
      "roles": [
        "adsb_receiver"
      ],
      "tags": [
        "adsb",
        "upstairs"
      ],
      "cockpit_enabled": true,
      "cockpit_scheme": "https",
      "cockpit_port": 9090,
      "service_discovery": true,
      "monitored_services": [
        "piaware.service",
        "dump1090-fa.service",
        "cockpit.socket"
      ],
      "critical_services": [
        "piaware.service",
        "dump1090-fa.service"
      ],
      "manageable_services": [
        "piaware.service",
        "dump1090-fa.service"
      ],
      "allowed_actions": [
        "apt.upgrade"
      ],
      "notes": "North-side receiver",
      "expected_listeners": [
        "tcp:22",
        "tcp:9090",
        "tcp:30003"
      ],
      "integrations": {
        "adsb": {
          "enabled": true,
          "critical": true,
          "interval_seconds": 15,
          "no_messages_seconds": 300
        },
        "packages": {
          "enabled": true,
          "interval_seconds": 21600
        }
      },
      "repositories": [
        {
          "name": "receiver-config",
          "path": "/home/pi/receiver-config"
        }
      ]
    }
  ]
}
