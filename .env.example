# CM5 SSH password used by install.sh and by pi_noc.py at runtime when
# authenticating to the CM5. Keep this file readable only by the service user.
CM5_SSH_PASS=

# Display hardware. Accepted values: ADA_BONNET or PIM_DHM.
DISPLAY=ADA_BONNET
PINOC_DISPLAY_ENABLED=1

# Responsive web console (set enabled to 0 for display-only installs).
PINOC_WEB_ENABLED=1
PINOC_WEB_HOST=0.0.0.0
PINOC_WEB_PORT=8088

# Optional SQLite history location (never place this inside .venv).
PINOC_DATABASE_PATH=
PINOC_AUTH_ENABLED=0
# Generate a long random value; changing it invalidates all browser sessions.
PINOC_SECRET_KEY=
# Set to 1 only when PiNOC is served over HTTPS.
PINOC_SECURE_COOKIE=0
