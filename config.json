{
  "vpn_interface": "wg0",
  "vpn_service": "wg-quick@wg0.service",
  "vpn_stale_seconds": 150,
  "web_host": "0.0.0.0",
  "web_port": 8088,
  "authentication": {
    "enabled": false,
    "session_timeout_seconds": 3600
  },
  "development_gateway": {
    "artifact_root": "data/jobs",
    "default_timeout_seconds": 300,
    "max_timeout_seconds": 1800,
    "output_limit_bytes": 262144,
    "file_read_limit_bytes": 1048576,
    "artifact_file_limit_bytes": 10485760,
    "artifact_total_limit_bytes": 26214400,
    "artifact_count": 20,
    "offline_seconds": 45
  },
  "polling": {
    "local_seconds": 10,
    "network_seconds": 10,
    "remote_health_seconds": 10,
    "service_seconds": 15,
    "storage_seconds": 60,
    "sensor_seconds": 10,
    "fleet_seconds": 10
  },
  "devices_file": "config/devices.json",
  "fleet_max_workers": 4,
  "ssh_command_timeout": 8,
  "health_thresholds": {
    "cpu_warning": 70,
    "memory_warning": 80,
    "temperature_warning": 70,
    "temperature_critical": 80,
    "disk_warning": 80,
    "disk_critical": 95,
    "stale_seconds": 30,
    "offline_seconds": 120
  },
  "history": {
    "enabled": true,
    "database_path": "data/pinoc.db",
    "core_interval_seconds": 60,
    "network_interval_seconds": 60,
    "storage_interval_seconds": 300,
    "raw_retention_days": 7,
    "hourly_retention_days": 90,
    "daily_retention_days": 365,
    "maintenance_interval_seconds": 3600,
    "thresholds": {
      "temperature_warning": 70,
      "temperature_critical": 80,
      "temperature_hysteresis": 3,
      "cpu_warning": 90,
      "cpu_duration_seconds": 300,
      "memory_warning": 85,
      "disk_warning": 80,
      "disk_critical": 95,
      "disk_hysteresis": 2
    }
  },
  "playbooks": [
    {
      "id": "service-failed",
      "alert_type": "service_failed",
      "title": "Service failed",
      "markdown": "## Triage\n- Check the service's recent logs: `journalctl -u <service> -n 200`\n- Look at the device page for CPU, memory, or disk pressure that could have crashed it.\n- Restart the service once; if it fails again, inspect its configuration and free disk space.",
      "actions": [
        "service.restart",
        "device.refresh"
      ],
      "links": []
    },
    {
      "id": "device-offline",
      "alert_type": "device_offline",
      "title": "Device offline",
      "markdown": "## Triage\n- Ping the device and check its switch port or Wi-Fi association.\n- If reachable, request a refresh; otherwise power-cycle it (Cockpit or physically).\n- Repeated offline periods plus media I/O errors usually mean storage wear.",
      "actions": [
        "device.refresh",
        "device.reboot"
      ],
      "links": []
    },
    {
      "id": "critical-disk-usage",
      "alert_type": "critical_disk_usage",
      "title": "Filesystem nearly full",
      "markdown": "## Triage\n- Find the largest consumers: `du -xh --max-depth=2 <mount> | sort -h | tail`\n- Common culprits: journal logs, recording buffers, core dumps, failed package caches.\n- Free space before the filesystem fills; a repeat alert suggests a retention problem.",
      "actions": [
        "device.refresh",
        "package.check"
      ],
      "links": []
    },
    {
      "id": "raid-degraded",
      "alert_type": "raid_degraded",
      "title": "RAID degraded",
      "markdown": "## Triage\n- Identify the failed member: `cat /proc/mdstat` plus a SMART check per disk.\n- Replace the failed disk and start a rebuild **before** a second failure.\n- Keep I/O light until the rebuild completes.",
      "actions": [
        "device.refresh"
      ],
      "links": []
    },
    {
      "id": "probe-failed",
      "alert_type": "probe_failed",
      "title": "Connectivity probe failed",
      "markdown": "## Triage\n- The alert message lists every failing check.\n- Probe the same target from another host to separate a device-local fault from a network fault.\n- Refresh the device so the probe re-runs on the next interval.",
      "actions": [
        "device.refresh"
      ],
      "links": []
    }
  ],
  "remote_host": "192.168.1.200",
  "remote_user": "pi",
  "remote_ssh_port": 22,
  "remote_paths": [
    {
      "name": "JONAH",
      "path": "/srv/jonah"
    },
    {
      "name": "TIME MACHINE",
      "path": "/mnt/timemachine"
    }
  ],
  "raid_device": "md0",
  "remote_temp_monitor": {
    "enabled": true,
    "endpoint": "http://192.168.1.201:9877/temps",
    "poll_seconds": 10,
    "timeout_seconds": 3,
    "max_device_age": 60,
    "shared_secret": "",
    "collect_system_metrics": true,
    "ssh_user": "pi",
    "ssh_port": 22
  },
  "inside_sensor": {
    "enabled": true,
    "type": "auto",
    "i2c_addresses": [
      "0x76",
      "0x77",
      "0x44",
      "0x45"
    ]
  },
  "vpn_optional_wifi_networks": [
    "wiffy",
    "wiffyToo"
  ],
  "integration_polling": {
    "probe_seconds": 30,
    "adsb_seconds": 15,
    "desk_display_seconds": 15,
    "magicmirror_seconds": 15,
    "ics_modifier_seconds": 60,
    "pi_hotspot_seconds": 30,
    "wireguard_seconds": 15,
    "samba_seconds": 30,
    "raid_seconds": 30,
    "disk_health_seconds": 300,
    "packages_seconds": 21600,
    "git_seconds": 300,
    "lan_inventory_seconds": 600
  },
  "lan_inventory": {
    "enabled": false,
    "source_path": "",
    "interval_seconds": 600
  }
}
