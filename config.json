{
  "vpn_interface": "wg0",
  "vpn_service": "wg-quick@wg0.service",
  "vpn_stale_seconds": 150,
  "refresh_seconds": 10,
  "auto_rotate_seconds": 8,
  "web_enabled": true,
  "web_host": "0.0.0.0",
  "web_port": 8088,
  "authentication": {
    "enabled": false,
    "session_timeout_seconds": 3600
  },
  "polling": {
    "local_seconds": 10,
    "network_seconds": 10,
    "remote_health_seconds": 10,
    "service_seconds": 15,
    "storage_seconds": 60,
    "sensor_seconds": 10,
    "fleet_seconds": 10
  },
  "devices_file": "config/devices.json",
  "fleet_max_workers": 4,
  "ssh_command_timeout": 8,
  "health_thresholds": {
    "cpu_warning": 70,
    "memory_warning": 80,
    "temperature_warning": 70,
    "temperature_critical": 80,
    "disk_warning": 80,
    "disk_critical": 95,
    "stale_seconds": 30,
    "offline_seconds": 120
  },
  "history": {
    "enabled": true,
    "database_path": "data/pinoc.db",
    "core_interval_seconds": 60,
    "network_interval_seconds": 60,
    "storage_interval_seconds": 300,
    "raw_retention_days": 7,
    "hourly_retention_days": 90,
    "daily_retention_days": 365,
    "maintenance_interval_seconds": 3600,
    "thresholds": {
      "temperature_warning": 70,
      "temperature_critical": 80,
      "temperature_hysteresis": 3,
      "cpu_warning": 90,
      "cpu_duration_seconds": 300,
      "memory_warning": 85,
      "disk_warning": 80,
      "disk_critical": 95,
      "disk_hysteresis": 2
    }
  },
  "remote_host": "192.168.1.200",
  "remote_user": "pi",
  "remote_ssh_port": 22,
  "remote_paths": [
    {
      "name": "JONAH",
      "path": "/srv/jonah"
    },
    {
      "name": "TIME MACHINE",
      "path": "/mnt/timemachine"
    }
  ],
  "raid_device": "md0",
  "display_address": "0x3c",
  "remote_temp_monitor": {
    "enabled": true,
    "endpoint": "http://192.168.1.201:9877/temps",
    "poll_seconds": 10,
    "timeout_seconds": 3,
    "max_device_age": 60,
    "shared_secret": ""
  },
  "inside_sensor": {
    "enabled": true,
    "type": "auto",
    "i2c_addresses": [
      "0x76",
      "0x77",
      "0x44",
      "0x45"
    ]
  },
  "vpn_optional_wifi_networks": [
    "wiffy",
    "wiffyToo"
  ],
  "integration_polling": {
    "adsb_seconds": 15,
    "desk_display_seconds": 15,
    "magicmirror_seconds": 15,
    "ics_modifier_seconds": 60,
    "pi_hotspot_seconds": 30,
    "wireguard_seconds": 15,
    "samba_seconds": 30,
    "raid_seconds": 30,
    "disk_health_seconds": 300,
    "packages_seconds": 21600,
    "git_seconds": 300,
    "lan_inventory_seconds": 600
  },
  "lan_inventory": {
    "enabled": false,
    "source_path": "",
    "interval_seconds": 600
  }
}
